<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScoreForge.ViewModels"
             xmlns:controls="using:ScoreForge.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="720"
             x:Class="ScoreForge.Views.CribbageBoardView"
             x:DataType="vm:CribbageBoardViewModel">
  <Grid>
    <!-- Header / board / peg controls: peg row stays on-screen; board takes leftover height -->
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Cribbage" Opacity="0.7" />
          </StackPanel>
          <Button Grid.Column="1" Content="Home" Command="{Binding BackHomeCommand}" />
        </Grid>

        <Border Padding="12"
                CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
          <TextBlock Text="{Binding StatusBanner}" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Undo peg" Command="{Binding UndoLastCommand}" MinHeight="44" />
          <Button Content="Reset board" Command="{Binding ResetScoresCommand}" MinHeight="44" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="IndianRed"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <Border Grid.Row="1"
              CornerRadius="12"
              ClipToBounds="True"
              BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              MinHeight="160">
        <controls:CribbageBoardControl Players="{Binding Players}"
                                       TargetScore="{Binding TargetScore}"
                                       Margin="4" />
      </Border>

      <Border Grid.Row="2"
              Margin="0,12,0,0"
              Padding="12"
              CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="Active pegger" FontWeight="SemiBold" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Players}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CribbagePlayerViewModel">
                  <Button MinHeight="44"
                          MinWidth="110"
                          Command="{Binding $parent[ItemsControl].((vm:CribbageBoardViewModel)DataContext).SelectPlayerCommand}"
                          CommandParameter="{Binding}"
                          Classes.accent="{Binding IsSelected}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="14" Height="14" Fill="{Binding PegBrush}" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Total, StringFormat='({0})'}" VerticalAlignment="Center" Opacity="0.75" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Text="Peg points" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding QuickScores}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding}"
                        Width="48"
                        Height="40"
                        Margin="0,0,6,6"
                        Classes="accent"
                        Command="{Binding $parent[ItemsControl].((vm:CribbageBoardViewModel)DataContext).PegPointsCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Win celebration overlay -->
    <Panel IsVisible="{Binding ShowCelebration}" ZIndex="100" Background="Transparent">
      <controls:FireworksControl IsPlaying="{Binding ShowCelebration}"
                                 WinnerName="{Binding WinnerName}" />
      <Button Content="Continue"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,28"
              MinHeight="44"
              MinWidth="140"
              Classes="accent"
              Command="{Binding DismissCelebrationCommand}" />
    </Panel>
  </Grid>
</UserControl>
