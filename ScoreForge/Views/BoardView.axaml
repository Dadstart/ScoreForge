<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScoreForge.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="ScoreForge.Views.BoardView"
             x:DataType="vm:BoardViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TemplateName}" Opacity="0.7" />
        </StackPanel>
        <Button Grid.Column="1" Content="Home" Command="{Binding BackHomeCommand}" />
      </Grid>

      <Border Padding="12"
              CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <TextBlock Text="{Binding StatusBanner}" FontSize="16" FontWeight="SemiBold" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Undo" Command="{Binding UndoLastCommand}" MinHeight="44" />
        <Button Content="Reset" Command="{Binding ResetScoresCommand}" MinHeight="44" />
        <Button Content="Mark complete" Command="{Binding MarkCompleteCommand}" MinHeight="44"
                IsVisible="{Binding !IsComplete}" />
        <Button Content="Add round" Command="{Binding BeginRoundCommand}" Classes="accent" MinHeight="44"
                IsVisible="{Binding IsRoundsMode}" />
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="IndianRed"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Free Play cards -->
    <ScrollViewer IsVisible="{Binding IsInstantMode}">
      <ItemsControl ItemsSource="{Binding Standings}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StandingViewModel">
            <Border Width="200"
                    Margin="0,0,12,12"
                    Padding="16"
                    CornerRadius="12"
                    BorderThickness="2"
                    BorderBrush="{DynamicResource SystemAccentColor}">
              <StackPanel Spacing="12" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Total}"
                           FontSize="48"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                  <Button Content="−"
                          FontSize="28"
                          Width="56"
                          Height="56"
                          Command="{Binding $parent[ItemsControl].((vm:BoardViewModel)DataContext).DecrementCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="+"
                          FontSize="28"
                          Width="56"
                          Height="56"
                          Classes="accent"
                          Command="{Binding $parent[ItemsControl].((vm:BoardViewModel)DataContext).IncrementCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
                <TextBlock Text="Leader"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           IsVisible="{Binding IsLeader}" />
                <TextBlock Text="Winner"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           IsVisible="{Binding IsWinner}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Rounds board -->
    <Grid IsVisible="{Binding IsRoundsMode}" RowDefinitions="Auto,*,Auto">
      <!-- Totals strip -->
      <ItemsControl ItemsSource="{Binding Standings}" Margin="0,0,0,12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StandingViewModel">
            <Border Padding="12,8" CornerRadius="8" MinWidth="100"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Total, StringFormat='Total: {0}'}" FontSize="18" />
                <TextBlock Text="Winner" IsVisible="{Binding IsWinner}" FontWeight="Bold" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="4">
          <ItemsControl ItemsSource="{Binding PlayerHeaders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Width="90" Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding RoundRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoundRowViewModel">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                  <TextBlock Width="48" Text="{Binding RoundNumber, StringFormat='# {0}'}" VerticalAlignment="Center" />
                  <ItemsControl ItemsSource="{Binding Scores}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="90" Padding="8,6" CornerRadius="4"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                          <TextBlock Text="{Binding}" HorizontalAlignment="Center" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Round entry panel -->
      <Border Grid.Row="2"
              Margin="0,12,0,0"
              Padding="12"
              CornerRadius="8"
              BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              IsVisible="{Binding IsEnteringRound}">
        <StackPanel Spacing="12">
          <TextBlock Text="Enter scores for this round" FontWeight="SemiBold" FontSize="16" />
          <ItemsControl ItemsSource="{Binding RoundEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoundScoreEntryViewModel">
                <Grid ColumnDefinitions="160,*" Margin="0,0,0,8">
                  <TextBlock Text="{Binding PlayerName}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding ScoreText}"
                           PlaceholderText="Score"
                           MinHeight="44" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Submit round" Command="{Binding SubmitRoundCommand}" Classes="accent" MinHeight="44" />
            <Button Content="Cancel" Command="{Binding CancelRoundCommand}" MinHeight="44" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
