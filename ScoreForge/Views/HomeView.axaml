<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScoreForge.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="ScoreForge.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
      <TextBlock Text="Games" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Resume a saved game or start something new." Opacity="0.7" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="New Game" Command="{Binding NewGameCommand}" Classes="accent" />
        <Button Content="Refresh" Command="{Binding LoadCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="IndianRed"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <Panel>
      <TextBlock Text="Loading…"
                 IsVisible="{Binding IsBusy}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

      <ItemsControl ItemsSource="{Binding Games}" IsVisible="{Binding !IsBusy}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameListItemViewModel">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding TemplateName, StringFormat='{}{0}'}" Opacity="0.7" />
                  <TextBlock Opacity="0.7">
                    <Run Text="{Binding StatusText, Mode=OneWay}" />
                    <Run Text=" · Updated " />
                    <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="Resume"
                          Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).ResumeCommand}"
                          CommandParameter="{Binding}" />
                  <Button Content="Delete"
                          Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).DeleteCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Panel>
  </DockPanel>
</UserControl>
