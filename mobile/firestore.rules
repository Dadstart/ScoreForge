rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: games
    // Document ID: 6-character share code from 23456789ABCDEFGHJKLMNPQRSTUVWXYZ
    // The code is the capability. Callers must still be signed in (anonymous
    // auth is enough). Games cannot be listed. Events are stored on this
    // document so a collection-group query cannot discover codes.
    //
    // Fields:
    //   - id: string (required, immutable, equal to the document id)
    //   - shareCode: string (required, immutable, equal to the document id)
    //   - name: string (required, 1-80)
    //   - templateId: string (required, immutable, known template)
    //   - playMode: 'pass-and-play' | 'multi-device' (required)
    //   - players: list (required, 1-12 maps of id/name/optional token)
    //   - events: list (required, max 800 score maps). Rules cannot walk every
    //     element; the size cap is the guard against a huge write.
    //   - status: 'InProgress' | 'Completed' (required)
    //   - targetScore: number 0-1000000 or null (required key)
    //   - maxRounds: number 0-1000000 or null (required key)
    //   - tokenSpaces: map (required, max 12 entries)
    //   - sorry, parcheesi, danger, backgammon, checkers, chess, canasta, uneaux, skipBeaux, reversi, chinese, klondike, freecell, pyramid, tripeaks, spider, yahtzee, monopoly: map or null, optional until every client sends them
    //   - revision: int (required, starts at 1, increases by 1)
    //   - createdAt, updatedAt: ISO-8601 strings (createdAt immutable)
    //
    // Subcollection: games/{shareCode}/events/{eventId}
    // Legacy copies only. Readable while the parent has no events field.
    // After events move onto the parent, list and get are denied. Delete by
    // id stays allowed so the app can remove those docs.
    //
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isShareCode(code) {
      return code is string
        && code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$');
    }

    function isIsoTime(value) {
      return value is string && value.size() >= 20 && value.size() <= 40;
    }

    function isOptionalScore(value) {
      return value == null || (value is number && value >= 0 && value <= 1000000);
    }

    // Inlined on purpose. A function call per seat pushes a full table past
    // the 1000-expression evaluation limit, and Firestore then denies the save.
    function playersValid(players) {
      return players is list
        && players.size() >= 1
        && players.size() <= 12
        && players[0] is map && players[0].size() <= 4 && players[0].id is string && players[0].name is string
        && (players.size() < 2 || (players[1] is map && players[1].size() <= 4 && players[1].id is string && players[1].name is string))
        && (players.size() < 3 || (players[2] is map && players[2].size() <= 4 && players[2].id is string && players[2].name is string))
        && (players.size() < 4 || (players[3] is map && players[3].size() <= 4 && players[3].id is string && players[3].name is string))
        && (players.size() < 5 || (players[4] is map && players[4].size() <= 4 && players[4].id is string && players[4].name is string))
        && (players.size() < 6 || (players[5] is map && players[5].size() <= 4 && players[5].id is string && players[5].name is string))
        && (players.size() < 7 || (players[6] is map && players[6].size() <= 4 && players[6].id is string && players[6].name is string))
        && (players.size() < 8 || (players[7] is map && players[7].size() <= 4 && players[7].id is string && players[7].name is string))
        && (players.size() < 9 || (players[8] is map && players[8].size() <= 4 && players[8].id is string && players[8].name is string))
        && (players.size() < 10 || (players[9] is map && players[9].size() <= 4 && players[9].id is string && players[9].name is string))
        && (players.size() < 11 || (players[10] is map && players[10].size() <= 4 && players[10].id is string && players[10].name is string))
        && (players.size() < 12 || (players[11] is map && players[11].size() <= 4 && players[11].id is string && players[11].name is string));
    }

    function isKnownTemplate(templateId) {
      return templateId in [
        'free-play',
        'rounds',
        'rummy',
        'golf',
        'cribbage',
        'monopoly',
        'yaht',
        'yahtzee',
        'sorry',
        'parcheesi',
        'danger',
        'backgammon',
        'checkers',
        'chess',
        'canasta',
        'uneaux',
        'skip-beaux',
        'reversi',
        'chinese-checkers',
        'klondike',
        'freecell',
        'pyramid',
        'tripeaks',
        'spider'
      ];
    }

    function isValidGame(data) {
      return data.keys().hasOnly([
          'id',
          'shareCode',
          'name',
          'templateId',
          'playMode',
          'players',
          'events',
          'status',
          'targetScore',
          'maxRounds',
          'tokenSpaces',
          'sorry',
          'parcheesi',
          'danger',
          'backgammon',
          'checkers',
          'chess',
          'canasta',
          'uneaux',
          'skipBeaux',
          'reversi',
          'chinese',
          'klondike',
          'freecell',
          'pyramid',
          'tripeaks',
          'spider',
          'yahtzee',
          'monopoly',
          'revision',
          'createdAt',
          'updatedAt'
        ])
        && isShareCode(data.id)
        && data.shareCode == data.id
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && isKnownTemplate(data.templateId)
        && data.playMode in ['pass-and-play', 'multi-device']
        && playersValid(data.players)
        && data.events is list
        && data.events.size() <= 800
        && data.status in ['InProgress', 'Completed']
        && isOptionalScore(data.targetScore)
        && isOptionalScore(data.maxRounds)
        && data.tokenSpaces is map
        && data.tokenSpaces.size() <= 12
        && (!('sorry' in data) || data.sorry == null || data.sorry is map)
        && (!('parcheesi' in data) || data.parcheesi == null || data.parcheesi is map)
        && (!('danger' in data) || data.danger == null || data.danger is map)
        && (!('backgammon' in data) || data.backgammon == null || data.backgammon is map)
        && (!('checkers' in data) || data.checkers == null || data.checkers is map)
        && (!('chess' in data) || data.chess == null || data.chess is map)
        && (!('canasta' in data) || data.canasta == null || data.canasta is map)
        && (!('uneaux' in data) || data.uneaux == null || data.uneaux is map)
        && (!('skipBeaux' in data) || data.skipBeaux == null || data.skipBeaux is map)
        && (!('reversi' in data) || data.reversi == null || data.reversi is map)
        && (!('chinese' in data) || data.chinese == null || data.chinese is map)
        && (!('klondike' in data) || data.klondike == null || data.klondike is map)
        && (!('freecell' in data) || data.freecell == null || data.freecell is map)
        && (!('pyramid' in data) || data.pyramid == null || data.pyramid is map)
        && (!('tripeaks' in data) || data.tripeaks == null || data.tripeaks is map)
        && (!('spider' in data) || data.spider == null || data.spider is map)
        && (!('yahtzee' in data) || data.yahtzee == null || data.yahtzee is map)
        && (!('monopoly' in data) || data.monopoly == null || data.monopoly is map)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 1000000
        && isIsoTime(data.createdAt)
        && isIsoTime(data.updatedAt);
    }

    // Pass-and-play seats have no uid, so the share code is still enough to delete.
    // A separate-devices game stores the host uid on the first seat.
    function hostMayDelete() {
      return resource.data.players is list
        && resource.data.players.size() >= 1
        && resource.data.players[0] is map
        && (
          !('uid' in resource.data.players[0])
          || resource.data.players[0].uid == null
          || resource.data.players[0].uid == request.auth.uid
        );
    }

    function eventsStillExternal(code) {
      return exists(/databases/$(database)/documents/games/$(code))
        && !('events' in get(/databases/$(database)/documents/games/$(code)).data);
    }

    match /games/{shareCode} {
      allow get: if isSignedIn() && isShareCode(shareCode);
      allow list: if false;
      allow create: if isSignedIn()
        && isShareCode(shareCode)
        && isValidGame(request.resource.data)
        && request.resource.data.id == shareCode
        && request.resource.data.revision == 1;
      allow update: if isSignedIn()
        && isShareCode(shareCode)
        && isValidGame(request.resource.data)
        && request.resource.data.id == shareCode
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.templateId == resource.data.templateId;
      allow delete: if isSignedIn() && isShareCode(shareCode) && hostMayDelete();

      match /events/{eventId} {
        allow get, list: if isSignedIn() && isShareCode(shareCode) && eventsStillExternal(shareCode);
        allow delete: if isSignedIn() && isShareCode(shareCode);
        allow create, update: if false;
      }
    }
  }
}
