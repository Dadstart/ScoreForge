{
  "name": "scoreforge",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.24",
    "expo-linking": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.25",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/uuid": "^10.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 5555",
    "android": "expo start --android --port 5555",
    "ios": "expo start --ios --port 5555",
    "web": "expo start --web --port 5555",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "deploy:web": "npm run export:web && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:all": "npm run export:web && firebase deploy --only hosting,firestore:rules"
  },
  "private": true
